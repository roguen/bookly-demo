__pycache__/
*.pyc
# The live audit trail and its rotations. /api/reset rotates rather than
# truncates, so a demo reset never destroys the previous run's record.
audit.log
audit.log.*
# The human review queue's persisted state. Demo data, rebuilt by /api/reset.
queue.json
# The authored policy document (v3.2.0): an append-only change log a non-engineer
# writes from the back office. Runtime state like the queue — a clean clone has
# none, so it decides on the historical defaults. The temp is the atomic-write
# staging file; policy.checks.json is the suite's deliberately-absent path.
policy.json
policy.json.tmp
policy.checks.json
.claude/
.DS_Store

# Secrets. The agent reads ANTHROPIC_API_KEY from the environment and never
# from a file, so nothing here should ever exist — this is a backstop for a
# public repo, not a supported way to configure the key.
.env
.env.*
*.key
*.pem
secrets*

# PowerPoint lock files, created whenever the deck is open
~$*.pptx

# Deck QA render artifacts — the .pptx is the deliverable
Bookly_Agent_Architecture.pdf
slide-*.jpg

# Deck build tooling only; the agent itself needs no packages
node_modules/
package-lock.json
